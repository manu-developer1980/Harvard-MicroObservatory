# Google Drive OAuth Client ID (public, exposed to the browser).
# See README → "Google Drive upload" for the full setup steps.
# Required for the "Subir a Google Drive" button to work.
PUBLIC_GOOGLE_CLIENT_ID=518334781606-g4l6bplgkl7ca67sl1jc8mvei3vmrjb9.apps.googleusercontent.com

# Server-only: allowlist de orígenes autorizados a usar el proxy FITS
# (/api/fits/[file]). Lista separada por comas, sin espacios.
# - En DEV, si no se define, se autorizan automáticamente
#   http://localhost:4321 y http://localhost:8888.
# - En PROD, deny-by-default: si no se define, ningún origen podrá
#   descargar FITS vía fetch cross-origin (los <a download> del mismo
#   origen siguen funcionando, no requieren CORS).
# - El proxy añade Vary: Origin a TODAS las respuestas para evitar
#   cache poisoning en la CDN.
ALLOWED_FITS_ORIGINS=https://exotic.example.com

# Rate limiting (Edge Function, server-only). Configurar en Netlify
# Site settings → Environment variables.
# - Ventana fija en segundos (default 60).
# - Límite por IP por ventana para cada endpoint:
#     RATE_LIMIT_PREVIEW_MAX          default 30
#     RATE_LIMIT_TRANSIT_CHECK_MAX    default 20
# - Si excede, devuelve 429 con Retry-After.
# - El counter se guarda en Netlify Blobs (free tier) con TTL = 2× ventana.
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_PREVIEW_MAX=30
RATE_LIMIT_TRANSIT_CHECK_MAX=20
