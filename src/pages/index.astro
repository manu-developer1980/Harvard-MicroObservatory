---
import "../styles/global.css";
import Downloader from "@/components/Downloader.tsx";
import Footer from "@/components/Footer.tsx";
import { t, detectLangFromHeader, type Lang } from "@/lib/i18n";

const acceptLang = Astro.request.headers.get("accept-language");
const lang: Lang = detectLangFromHeader(acceptLang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-5WNVLMCF');
    </script>
    <!-- End Google Tag Manager -->
    <title>MicroObservatory Downloader</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="google-site-verification"
      content="sYVi8NbsalfBag2VttoLhcUgDqRN1VKanTk_swgFGDk"
    />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-5WNVLMCF"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <main>
      <Downloader client:load initialLang={lang} />
    </main>
    <!--
      El footer es React (no HTML estático) para que se re-renderice
      cuando el usuario cambia el idioma con el switcher. Si lo dejáramos
      en el HTML del SSR, quedaría fijado al Accept-Language del
      navegador y nunca cambiaría.
    -->
    <Footer client:load initialLang={lang} />
  </body>
</html>
