---
import "../styles/global.css";
import Downloader from "../components/Downloader.tsx";
import { t, detectLangFromHeader, type Lang } from "../lib/i18n";

const acceptLang = Astro.request.headers.get("accept-language");
const lang: Lang = detectLangFromHeader(acceptLang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t("app.lead", lang)} />
    <title>{t("app.title", lang)}</title>
  </head>
  <body>
    <main>
      <Downloader client:load initialLang={lang} />
    </main>
    <footer>
      <p class="credit">
        <a
          href="https://www.instagram.com/manu_astrofoto/"
          target="_blank"
          rel="noopener"
          aria-label={t("footer.igAria", lang)}
        >
          <svg
            class="ig-icon"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
          </svg>
          {t("footer.credit", lang)} <strong>@manu_astrofoto</strong> 🔭
        </a>
      </p>
      <p>
        {t("footer.datasrc", lang, {
          moLink: `<a href="https://waps.cfa.harvard.edu/microobservatory/" target="_blank" rel="noopener">${t("footer.moName", lang)}</a>`,
        })}
      </p>
    </footer>
  </body>
</html>
